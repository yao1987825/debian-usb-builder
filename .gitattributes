# 保证 shell 脚本在 Linux 上以 LF 结尾(CRLF 会导致 "/usr/bin/env bash^M: bad interpreter")
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.desktop text eol=lf
*.cfg  text eol=lf
# 没有扩展名的可执行脚本也要 LF
overlay/usr/local/bin/music      text eol=lf
overlay/usr/local/bin/net-doctor text eol=lf
overlay-n1/usr/local/bin/*       text eol=lf
