#!/usr/bin/env bash
#
# opencode —— AI 助手入口(包装版)
#
# 为什么要包一层:
#   opencode 是 Bun 写的, 它的 HTTP 客户端**只支持 http/https 代理**,
#   碰上 socks5:// 会直接抛 "unsupported proxy protocol"。
#
#   v1.9.0 起镜像**不再预置代理**(proxy 命令和 /etc/profile.d/99-proxy.sh 都删了),
#   所以这里只剩一个最小护栏: 万一用户自己 export 了 socks5 代理,
#   就把它摘掉走直连 —— 免得 opencode 一发请求就甩一个天书般的协议报错。
#   (以前那套"直连不通就去找同主机其它 HTTP 代理端口"的逻辑已经删掉了:
#    镜像不管代理, 用户要用就自己 export 一个 http/https 代理。)
#
#   真身在 /usr/local/lib/opencode/opencode(构建时装进去的)。
#
# 常用:
#   opencode                # 交互
#   opencode run "问题"      # 跑一次
#   opencode --net-check    # 只体检网络(能不能直连模型 API), 不启动 opencode
#
set -uo pipefail

REAL="/usr/local/lib/opencode/opencode"
R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; B=$'\033[1;34m'; N=$'\033[0m'

if [[ ! -x "$REAL" ]]; then
  echo "opencode: 找不到真正的程序 ${REAL}" >&2
  exit 127
fi

# ---------------------------------------------------------------- 代理环境变量

# 所有代理环境变量里, 第一个是 socks 的地址(没有就返回 1)
socks_proxy_url() {
  local v
  for v in "${HTTPS_PROXY:-}" "${https_proxy:-}" "${HTTP_PROXY:-}" "${http_proxy:-}" \
           "${ALL_PROXY:-}" "${all_proxy:-}"; do
    case "$v" in
      socks5://*|socks5h://*|socks4://*|socks://*) printf '%s' "$v"; return 0 ;;
    esac
  done
  return 1
}

# 直连能不能到模型 API(并行探几个常见的, 有一个通就算通)
direct_ok() {
  local tmp="$1" pids=() u code waited=0
  local urls=(
    "https://api.anthropic.com/v1/models"
    "https://api.openai.com/v1/models"
    "https://api.minimaxi.com"
    "https://api.deepseek.com"
  )
  for u in "${urls[@]}"; do
    ( code=$(curl -sS --max-time 6 --noproxy '*' -o /dev/null -w '%{http_code}' "$u" 2>/dev/null || echo 000)
      if [[ "$code" != "000" ]]; then touch "${tmp}.ok"; fi ) &
    pids+=($!)
  done
  # 最多等 8 秒, 通了就提前走
  while [[ $waited -lt 8 && ! -f "${tmp}.ok" ]]; do sleep 1; waited=$((waited+1)); done
  for p in "${pids[@]}"; do wait "$p" 2>/dev/null || true; done
  [[ -f "${tmp}.ok" ]]
}

# ---------------------------------------------------------------- 处理

NET_CHECK=0
for a in "$@"; do
  [[ "$a" == "--net-check" ]] && NET_CHECK=1
done

TMPD="$(mktemp -d)"
trap 'rm -rf "$TMPD"' EXIT

# 配置跟着当前用户走: opencode 的全局配置按 $HOME 找,
# `sudo opencode` 时 HOME=/root, 不指过去的话会用默认权限
# (external_directory 一律要人工确认, 表现为"访问不了项目目录外的文件")。
_cfg="${HOME:-}/.config/opencode/opencode.json"
if [[ -f "$_cfg" ]]; then
  export OPENCODE_CONFIG="$_cfg"
fi

socks="$(socks_proxy_url || true)"
if [[ -n "$socks" ]]; then
  # Bun 不认 socks5。与其甩协议报错, 不如摘掉变量走直连。
  # (http/https 代理 Bun 是支持的, 那种就原样留着)
  unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY 2>/dev/null || true
  echo "${Y}[opencode]${N} 检测到 socks5 代理 ${B}${socks}${N}, Bun 不支持该协议 —— 已改为直连" >&2
fi

if [[ "$NET_CHECK" == "1" ]]; then
  echo "代理环境变量:"
  env | grep -iE '^(http|https|all|no)_proxy=' || echo "  (没有设置代理)"
  echo "直连模型 API:"
  if direct_ok "$TMPD/check"; then
    echo "  ✅ 直连可用"
  else
    echo "  ❌ 直连不通"
    echo "     (国产模型 MiniMax / DeepSeek 一般直连就能用;"
    echo "      Claude / GPT 在国内需要自己 export 一个 http/https 代理)"
  fi
  exit 0
fi

exec "$REAL" "$@"
