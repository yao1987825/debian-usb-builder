#!/usr/bin/env bash
#
# opencode —— AI 助手入口(包装版)
#
# 为什么要包一层:
#   opencode 是 Bun 写的, 它的 HTTP 客户端**只支持 http/https 代理**。
#   而这套 U 盘系统的 `proxy` 命令默认导出的是 socks5://(路由上的 SOCKS5 端口),
#   于是 opencode 一发请求就报:
#       UnsupportedProxyProtocol / unsupported proxy protocol
#   —— 错在代理协议上, 不是 opencode 本身坏了, 更不是模型或 API key 的问题。
#
#   这里在启动真身之前先把代理处理掉:
#     1) 代理是 http/https  -> 原样使用(Bun 支持);
#     2) 代理是 socks5      -> 先试直连能不能到模型 API:
#                                 直连能 -> 去掉代理变量, 直接连(最常见);
#                                 直连不能 -> 找同一台机器上的 HTTP 代理端口
#                                             (8080/7890/3128/8118/10809/20171),
#                                             有就改用它;
#                                         都没有 -> 报错说清楚, 不让用户
#                                             面对一个天书般的协议报错。
#
#   真身在 /usr/local/lib/opencode/opencode(构建时装进去的)。
#
# 常用:
#   opencode                # 交互
#   opencode run "问题"      # 跑一次
#   opencode --net-check    # 只体检代理配置, 不启动 opencode
#
set -uo pipefail

REAL="/usr/local/lib/opencode/opencode"
R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; B=$'\033[1;34m'; N=$'\033[0m'

if [[ ! -x "$REAL" ]]; then
  echo "opencode: 找不到真正的程序 ${REAL}" >&2
  exit 127
fi

# ---------------------------------------------------------------- 探测代理

# 所有代理环境变量里, 第一个是 socks 的地址(没有就返回 1)
socks_proxy_url() {
  local v
  for v in "${HTTPS_PROXY:-}" "${https_proxy:-}" "${HTTP_PROXY:-}" "${http_proxy:-}" \
           "${ALL_PROXY:-}" "${all_proxy:-}"; do
    case "$v" in
      socks5://*|socks5h://*|socks4://*|socks://*) printf '%s' "$v"; return 0 ;;
    esac
  done
  return 1
}

# 直连能不能到模型 API(并行探几个常见的, 有一个通就算通)
direct_ok() {
  local tmp="$1" pids=() u code waited=0
  local urls=(
    "https://api.anthropic.com/v1/models"
    "https://api.openai.com/v1/models"
    "https://api.minimaxi.com"
    "https://api.deepseek.com"
  )
  for u in "${urls[@]}"; do
    ( code=$(curl -sS --max-time 6 --noproxy '*' -o /dev/null -w '%{http_code}' "$u" 2>/dev/null || echo 000)
      if [[ "$code" != "000" ]]; then touch "${tmp}.ok"; fi ) &
    pids+=($!)
  done
  # 最多等 8 秒, 通了就提前走
  while [[ $waited -lt 8 && ! -f "${tmp}.ok" ]]; do sleep 1; waited=$((waited+1)); done
  for p in "${pids[@]}"; do wait "$p" 2>/dev/null || true; done
  [[ -f "${tmp}.ok" ]]
}

# 某个 host:port 是不是 HTTP CONNECT 代理
# 探测目标用国内能直连的站点: 用 api.github.com 的话, 在部分网络里它自己就不通,
# 会被误判成"这个端口不是 HTTP 代理"。
is_http_proxy() {
  local host="$1" port="$2" code
  code=$(curl -sS --max-time 5 -x "http://${host}:${port}" -o /dev/null -w '%{http_code}' \
         https://www.baidu.com 2>/dev/null || echo 000)
  [[ "$code" != "000" ]]
}

# ---------------------------------------------------------------- 处理

NET_CHECK=0
for a in "$@"; do
  [[ "$a" == "--net-check" ]] && NET_CHECK=1
done

TMPD="$(mktemp -d)"
trap 'rm -rf "$TMPD"' EXIT

# 配置跟着当前用户走: opencode 的全局配置按 $HOME 找,
# `sudo opencode` 时 HOME=/root, 不指过去的话会用默认权限
# (external_directory 一律要人工确认, 表现为"访问不了项目目录外的文件")。
_cfg="${HOME:-}/.config/opencode/opencode.json"
if [[ -f "$_cfg" ]]; then
  export OPENCODE_CONFIG="$_cfg"
fi

socks="$(socks_proxy_url || true)"

if [[ -n "$socks" ]]; then
  hostport="${socks#*://}"
  hostport="${hostport%%/*}"
  host="${hostport%%:*}"
  if [[ "$host" == *@* ]]; then host="${host##*@}"; fi

  echo "${Y}[opencode]${N} 检测到 socks5 代理 ${B}${socks}${N}" >&2

  if direct_ok "$TMPD/direct"; then
    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY 2>/dev/null || true
    echo "${G}[opencode]${N} Bun 的 HTTP 客户端不支持 socks5 —— 已改为直连(直连可用)" >&2
  else
    found=""
    for p in 8080 7890 3128 8118 10809 20171 8888; do
      if is_http_proxy "$host" "$p"; then found="http://${host}:${p}"; break; fi
    done
    if [[ -n "$found" ]]; then
      export http_proxy="$found" https_proxy="$found" HTTP_PROXY="$found" HTTPS_PROXY="$found"
      unset all_proxy ALL_PROXY 2>/dev/null || true
      echo "${G}[opencode]${N} 已改用同主机的 HTTP 代理 ${B}${found}${N}" >&2
    else
      cat >&2 <<EOF
${R}[opencode] 错误${N}: 代理 ${B}${socks}${N} 是 socks5 协议, opencode(Bun) 只支持 http/https 代理;
         而直连模型 API 也不通, 同主机上也没找到 HTTP 代理端口。

         怎么办(挑一个):
           1) 关掉代理重试:        proxy off
           2) 换成 HTTP 代理地址:  proxy on http://<代理主机>:<端口>
           3) 用命令行工具直接测:  curl -x http://<代理主机>:<端口> https://api.anthropic.com
EOF
      exit 78
    fi
  fi
else
  # 没有代理变量时, 如果系统里有 /etc/profile.d 之类留下的残留也会被继承, 顺手清一下空值
  :
fi

if [[ "$NET_CHECK" == "1" ]]; then
  echo "代理环境变量:"
  env | grep -iE '^(http|https|all|no)_proxy=' || echo "  (没有设置代理)"
  echo "直连模型 API:"
  if direct_ok "$TMPD/check"; then echo "  ✅ 直连可用"; else echo "  ❌ 直连不通"; fi
  exit 0
fi

exec "$REAL" "$@"
