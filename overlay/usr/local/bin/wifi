#!/usr/bin/env bash
#
# wifi —— 无线网连接小工具
#
# 用户反馈(2026-10-27): "有线网络没问题, wifi 无法使用"
#
# 真因(真机逐层实测, 不是一个原因, 是三个叠在一起):
#   1) 这套系统没有面板、也没有托盘图标, 用户**没有任何点一下就能连 WiFi 的
#      入口** —— 只能敲 nmcli, 而小白不知道那玩意儿怎么用;
#   2) NetworkManager 的 polkit 策略把 network-control 设成"要管理员认证",
#      而这套无头系统里没有 polkit 认证代理(也没人输密码) —— 普通用户敲
#      nmcli 会直接吃到 "Not authorized to control networking";
#   3) 镜像里**一个网卡固件都没装** —— 换成 Intel/Realtek/USB 网卡的机器,
#      无线接口根本不出现(atheros ath9k 这种固件内置的除外)。
#
# 这个命令把三件事都补齐:
#   入口:  wifi / wifi connect <名字> 就能连;
#   授权:  内部走 sudo(这套系统里 sudo 是免密的), 绕过 polkit 那道坎;
#   诊断:  连不上时直接告诉你卡在哪一层(没网卡/没固件/被锁/密码错)。
#
# 用法:
#   wifi                    列出周围的无线网
#   wifi list               同上
#   wifi scan               重新扫描后再列
#   wifi connect <SSID>     连接(不给密码就交互式问, 输入不回显)
#   wifi disconnect         断开当前无线连接
#   wifi status             看当前状态(网卡/开关/连上了哪个)
#   wifi forget <SSID>      忘掉一个已保存的连接
#   wifi on | off           开/关无线
#   wifi unblock            解锁被 rfkill 挡住的网卡
#
set -uo pipefail

BLU=$'\033[1;34m'; GRN=$'\033[1;32m'; YEL=$'\033[1;33m'; RED=$'\033[1;31m'; RST=$'\033[0m'
ok()   { printf '  %s✅%s %s\n' "$GRN" "$RST" "$*"; }
bad()  { printf '  %s❌%s %s\n' "$RED" "$RST" "$*"; }
info() { printf '  %s·%s %s\n' "$BLU" "$RST" "$*"; }
warn() { printf '  %s⚠️ %s%s\n' "$YEL" "$*" "$RST"; }
die()  { printf '%s❌ %s%s\n' "$RED" "$*" "$RST" >&2; exit 1; }

# NetworkManager 的控制类操作需要 root: 普通用户会被 polkit 挡在外面
# ("Not authorized to control networking")。这套系统里 sudo 免密, 直接借它。
# 顺便: nmcli 走的是**系统总线**, 不需要导 DBUS_SESSION_BUS_ADDRESS ✓
NM() {
  if [[ "$(id -u)" == "0" ]]; then
    nmcli "$@"
  elif sudo -n true 2>/dev/null; then
    sudo -n nmcli "$@"
  else
    sudo nmcli "$@"
  fi
}

# 无线网卡接口名(没有就空)
wifi_dev() {
  NM -t -f DEVICE,TYPE device status 2>/dev/null \
    | awk -F: '$2 == "wifi" {print $1; exit}'
}

usage() {
  cat <<'EOF'
用法:
  wifi                    列出周围的无线网
  wifi list               同上
  wifi scan               重新扫描后再列
  wifi connect <名字>     连接(不给密码就问, 输入不回显)
  wifi disconnect         断开当前无线连接
  wifi status             看当前状态
  wifi forget <名字>      忘掉一个已保存的连接
  wifi on | off           开/关无线
  wifi unblock            解锁被 rfkill 挡住的网卡
EOF
}

# ---------- 列出周围的网 ----------
list_networks() {
  local dev; dev="$(wifi_dev)"
  if [[ -z "$dev" ]]; then
    bad "没找到无线网卡"
    info "原因 1: 这台机器的无线网卡没有驱动/固件(Intel 装 firmware-iwlwifi,"
    info "       Realtek 装 firmware-realtek, USB 网卡看 dmesg 里的固件报错)"
    info "原因 2: 网卡被 rfkill 挡着 —— 跑 wifi unblock"
    info "原因 3: 这台机器压根没有无线网卡"
    return 1
  fi
  info "无线网卡: ${dev}"
  local rows
  rows="$(NM -t -f SSID,SECURITY,SIGNAL,IN-USE device wifi list 2>/dev/null | grep -v '^$')"
  if [[ -z "$rows" ]]; then
    warn "没扫到任何无线网"
    info "试试: wifi scan(重新扫) / 靠近路由器 / 确认路由器开着 2.4G"
    return 1
  fi
  printf '\n  %s%-28s %-12s %-8s%s\n' "$BLU" "名字(SSID)" "加密" "信号" "$RST"
  printf '  %s\n' "------------------------------------------------------------"
  local ssid sec sig inuse
  while IFS=: read -r ssid sec sig inuse; do
    [[ -n "$ssid" ]] || continue
    local mark=""
    [[ "$inuse" == "*" ]] && mark="  ← 已连接"
    printf '  %-28s %-12s %-8s%s\n' "${ssid:0:28}" "${sec:-开放}" "${sig:-?}" "$mark"
  done <<<"$rows"
  printf '\n'
  info "连接: wifi connect \"名字\"   (密码会问你, 输入不回显)"
}

# ---------- 状态 ----------
status() {
  local dev; dev="$(wifi_dev)"
  if [[ -z "$dev" ]]; then
    bad "没有无线网卡"
  else
    ok "无线网卡: ${dev} ($(NM -f GENERAL.DRIVER device show "$dev" 2>/dev/null | cut -d: -f2- | tr -d ' '))"
    local fw; fw="$(NM -f GENERAL.FIRMWARE-MISSING device show "$dev" 2>/dev/null | cut -d: -f2- | tr -d ' ')"
    [[ "$fw" == "是" ]] && warn "固件缺失 —— 网卡可能扫不到网(装对应的 firmware-* 包)"
  fi
  local radio; radio="$(NM radio wifi 2>/dev/null | tr -d ' ')"
  case "$radio" in
    已启用|enabled) ok "无线开关: 已启用" ;;
    *) bad "无线开关: ${radio:-未知}(wifi on 可以打开)" ;;
  esac
  local con; con="$(NM -t -f NAME,DEVICE,TYPE con show --active 2>/dev/null | awk -F: '$3=="802-11-wireless"{print $1; exit}')"
  if [[ -n "$con" ]]; then
    ok "已连接: ${con}"
    NM -f IP4.ADDRESS dev show "$(wifi_dev)" 2>/dev/null | awk -F: '/IP4.ADDRESS/{gsub(/^ +| +$/,"",$2); if($2!="") print "  IP 地址: "$2}'
  else
    info "当前没连无线网(wifi connect \"名字\" 可以连)"
  fi
}

# ---------- 连接 ----------
connect_ssid() {
  local ssid="${1:-}"
  [[ -n "$ssid" ]] || die "要连哪个网? 例如: wifi connect \"Yao-Router\""
  local dev; dev="$(wifi_dev)"
  [[ -n "$dev" ]] || die "没找到无线网卡, 先跑 wifi status 看原因"

  # 已经保存过这个网 -> 直接 up
  if NM -t -f NAME con show 2>/dev/null | awk -F: '{print $1}' | grep -Fxq "$ssid"; then
    info "已有保存的连接, 直接启用: ${ssid}"
    if NM con up "$ssid" >/dev/null 2>&1; then
      ok "已连上 ${ssid}"
    else
      bad "启用失败(密码过期? 跑 wifi forget \"$ssid\" 再连一次)"
    fi
    return
  fi

  # 看这个网要不要密码
  local sec
  sec="$(NM -t -f SSID,SECURITY device wifi list 2>/dev/null | awk -F: -v s="$ssid" '$1==s{print $2; exit}')"
  local pw=""
  if [[ -n "${sec}" && "$sec" != "--" ]]; then
    printf '  %s密码(输入不回显, 直接回车为空):%s ' "$BLU" "$RST"
    read -rs pw </dev/tty 2>/dev/null || pw=""
    printf '\n'
  fi
  local out
  if [[ -n "$pw" ]]; then
    out="$(NM dev wifi connect "$ssid" password "$pw" 2>&1)"
  else
    out="$(NM dev wifi connect "$ssid" 2>&1)"
  fi
  if printf '%s' "$out" | grep -qiE 'successfully|已成功|已激活'; then
    ok "已连上 ${ssid}"
  else
    bad "连接失败: ${out##*$'\n'}"
    info "密码错/信号弱/路由器改了密码, 都会这样; 也可以 wifi status 看当前状态"
  fi
}

case "${1:-list}" in
  list|"")   list_networks ;;
  scan)
    info "重新扫描中..."
    NM dev wifi rescan >/dev/null 2>&1 || true
    sleep 2
    list_networks
    ;;
  status)    status ;;
  connect)
    shift
    connect_ssid "${1:-}"
    ;;
  disconnect)
    con="$(NM -t -f NAME,TYPE con show --active 2>/dev/null | awk -F: '$2=="802-11-wireless"{print $1; exit}')"
    if [[ -n "$con" ]]; then
      NM con down "$con" >/dev/null 2>&1 && ok "已断开 ${con}" || bad "断开失败"
    else
      info "当前没连无线网"
    fi
    ;;
  forget)
    shift
    ssid="${1:-}"
    [[ -n "$ssid" ]] || die "要忘掉哪个? 例如: wifi forget \"Yao-Router\""
    NM con delete "$ssid" >/dev/null 2>&1 && ok "已忘掉 ${ssid}" || bad "没有这个连接配置"
    ;;
  on)   NM radio wifi on  >/dev/null 2>&1 && ok "无线已打开" || bad "打开失败(需要权限?)" ;;
  off)  NM radio wifi off >/dev/null 2>&1 && ok "无线已关闭" || bad "关闭失败(需要权限?)" ;;
  unblock)
    if command -v rfkill >/dev/null 2>&1; then
      rfkill unblock wifi 2>/dev/null || sudo -n rfkill unblock wifi 2>/dev/null
      ok "已尝试解锁无线网卡"
    else
      warn "没装 rfkill(装上 rfkill 包才能解锁)"
    fi
    NM radio wifi on >/dev/null 2>&1 || true
    ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
