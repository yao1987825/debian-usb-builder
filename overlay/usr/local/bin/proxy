#!/usr/bin/env bash
#
# proxy —— 代理开关(默认 SOCKS5 192.168.6.1:1070)
#
# 用法:
#   proxy                 等同 proxy status
#   proxy status          看当前代理状态(配置 / 连通性 / 各组件是否用上了)
#   proxy on              开启: apt + 下载器 + 终端环境变量都走代理
#   proxy on <地址>       开启并换成别的地址
#   proxy off             全部关掉
#   proxy test            实测: 真发一个请求看能不能出去
#
# 设计要点:
#   * 镜像里预置了 /etc/profile.d/99-proxy.sh, 它会先"探一下代理端口通不通",
#     通了才 export http_proxy, 不通就什么都不设。
#     这一步是刻意的: 代理没跑的时候如果还硬设 http_proxy, 症状是"所有下载
#     全部失败", 比压根没有代理更难查。
#   * apt 用不了这种"先探后用"的写法, 所以 apt 的代理由 proxy on / off 显式开关。
#   * SOCKS5 需要 PySocks: Python 的 requests 默认不支持 socks5:// 代理,
#     没装会直接报 ProxySchemeUnknown。proxy on 会顺手补装。
#
set -uo pipefail

CONF="/etc/proxy.conf"
PROFILE_D="/etc/profile.d/99-proxy.sh"
APT_CONF="/etc/apt/apt.conf.d/99proxy"
DL_CONF="/home/user/projects/gequhai-downloader/config.json"
DEFAULT_URL="${PROXY_URL_DEFAULT:-socks5://192.168.6.1:1070}"

R=$'\033[1;31m'; G=$'\033[1;32m'; Y=$'\033[1;33m'; B=$'\033[1;34m'; N=$'\033[0m'
say()  { printf '%s[proxy]%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '  %s✅%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s⚠️ %s%s\n' "$Y" "$*" "$N"; }
die()  { printf '  %s❌ %s%s\n' "$R" "$*" "$N" >&2; exit 1; }
info() { printf '  %s· %s%s\n' "$B" "$*" "$N"; }

usage() {
  sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
}

need_root() { [[ "$(id -u)" == "0" ]] || die "需要 root: sudo proxy $*"; }

# ---------------------------------------------------------------- 读配置
read_conf() {
  if [[ -f "$CONF" ]]; then
    # shellcheck disable=SC1090
    . "$CONF"
    printf '%s' "${PROXY_URL:-$DEFAULT_URL}"
  else
    printf '%s' "$DEFAULT_URL"
  fi
}

# 补全协议: 用户只写 "192.168.6.1:1070" 时按 SOCKS5 处理
norm_url() {
  local u="${1:-}"
  [[ -n "$u" ]] || die "地址不能为空"
  [[ "$u" == *"://"* ]] || u="socks5://${u}"
  printf '%s' "$u"
}

# apt 只认 socks5h://(由代理端做 DNS), http://, https://
apt_url() {
  case "$1" in
    socks5://*)  printf 'socks5h://%s' "${1#socks5://}" ;;
    socks5h://*) printf '%s' "$1" ;;
    *)           printf '%s' "$1" ;;
  esac
}

host_port() {
  local u="$1" hp
  hp="${u#*://}"
  hp="${hp%%/*}"
  hp="${hp##*@}"
  printf '%s %s' "${hp%%:*}" "${hp##*:}"
}

port_alive() {
  local a="$1" p="$2"
  timeout 1 bash -c 'exec 3<>"/dev/tcp/$0/$1"' "$a" "$p" 2>/dev/null
}

# ---------------------------------------------------------------- 写终端环境变量
# 只负责把模板打到 stdout, 不碰任何文件 —— 构建脚本要用它在 chroot 里生成
# /etc/profile.d/99-proxy.sh, 直接调用 proxy 去写会写到构建机的真实 /etc 上。
print_profile_d() {
  local url="$1"
  cat <<EOF
# 由 proxy 生成, 手动改会被下次 proxy on 覆盖
#
# 逻辑: 每次登录 shell 先探一下代理端口。通了才 export http_proxy,
#       不通就什么都不设 —— 免得代理没跑时所有下载全挂, 反而更难查。
PROXY_URL="${url}"

__p="\${PROXY_URL#*://}"; __p="\${__p%%/*}"; __p="\${__p##*@}"
__a="\${__p%%:*}"; __pt="\${__p##*:}"
[ "\$__a" = "\$__p" ] && __pt=1080

if timeout 1 bash -c 'exec 3<>"/dev/tcp/\$0/\$1"' "\$__a" "\$__pt" 2>/dev/null; then
  export http_proxy="\$PROXY_URL"  https_proxy="\$PROXY_URL"  all_proxy="\$PROXY_URL"
  export HTTP_PROXY="\$PROXY_URL" HTTPS_PROXY="\$PROXY_URL" ALL_PROXY="\$PROXY_URL"
  export no_proxy="localhost,127.0.0.1,::1"
  export NO_PROXY="localhost,127.0.0.1,::1"
  unset __p __a __pt
else
  unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY 2>/dev/null || true
fi
EOF
}

write_profile_d() { print_profile_d "$1" > "$PROFILE_D"; chmod 0644 "$PROFILE_D"; }

# ---------------------------------------------------------------- 下载器配置
set_downloader() {
  local url="$1"
  [[ -f "$DL_CONF" ]] || return 0
  python3 - "$DL_CONF" "$url" <<'PY'
import json, sys
path, proxy = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    data = {}
data["proxy"] = proxy
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
print(f"  下载器 proxy = {proxy!r}")
PY
}

# requests 走 socks5:// 需要 PySocks, 没装必然报错
ensure_pysocks() {
  local v="/home/user/.venvs/music/bin/python"
  [[ -x "$v" ]] || return 0
  if "$v" -c "import socks" 2>/dev/null; then
    info "music 虚拟环境已装 PySocks"
    return 0
  fi
  info "补装 PySocks(requests 走 socks5 代理必需)..."
  if su - user -c "'/home/user/.venvs/music/bin/pip' install --disable-pip-version-check --no-cache-dir -q pysocks" 2>&1 | sed 's/^/      /'; then
    if "$v" -c "import socks" 2>/dev/null; then
      ok "PySocks 已装好, music single 可以走 SOCKS5"
    else
      warn "PySocks 没装成功 —— music single 走 socks5 代理会失败"
    fi
  else
    warn "PySocks 安装失败 —— 联网后重跑: sudo proxy on"
  fi
}

# ---------------------------------------------------------------- 子命令
cmd_on() {
  need_root on
  local url; url="$(norm_url "${1:-$(read_conf)}")"
  local a p; read -r a p <<< "$(host_port "$url")"

  say "开启代理: ${url}"
  printf 'PROXY_URL="%s"\n' "$url" > "$CONF"
  chmod 0644 "$CONF"
  write_profile_d "$url"
  ok "已写 ${PROFILE_D}(登录新终端自动生效)"

  mkdir -p "$(dirname "$APT_CONF")"
  {
    echo "# 由 /usr/local/bin/proxy 生成; proxy off 会删掉它"
    echo "Acquire::http::Proxy  \"$(apt_url "$url")\";"
    echo "Acquire::https::Proxy \"$(apt_url "$url")\";"
  } > "$APT_CONF"
  chmod 0644 "$APT_CONF"
  ok "已写 ${APT_CONF}(apt 走代理)"

  set_downloader "$url"
  ok "下载器配置已更新"

  if port_alive "$a" "$p"; then
    ok "代理端口 ${a}:${p} 通的"
    ensure_pysocks
  else
    warn "代理端口 ${a}:${p} 现在连不上 —— 终端环境变量会自动跳过(不影响直连)"
    warn "下载器和 apt 在代理启动前会失败, 起来之后重跑一次: sudo proxy on"
  fi

  echo
  say "当前这个终端还没生效, 想立刻用就执行:"
  echo "    export http_proxy='${url}' https_proxy='${url}' all_proxy='${url}'"
  echo "或者直接开一个新终端。"
}

cmd_off() {
  need_root off
  say "关闭代理"
  rm -f "$APT_CONF" && ok "已删 ${APT_CONF}"
  # profile.d 保留但把 PROXY_URL 清空 —— 保留文件是为了让 proxy status 还能解释系统状态
  printf '# 由 proxy off 停用。重新开启: sudo proxy on\nPROXY_URL=""\n' > "$PROFILE_D"
  chmod 0644 "$PROFILE_D"
  ok "已停用 ${PROFILE_D}(终端不再自动设 http_proxy)"
  set_downloader ""
  ok "下载器代理已清空"
  echo
  say "当前终端里已经 export 过的变量要手动清:"
  echo "    unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY"
}

cmd_status() {
  local url a p
  url="$(read_conf)"
  read -r a p <<< "$(host_port "$url")"

  say "=== 代理状态 ==="
  info "配置地址   : ${url}"
  info "配置文件   : ${CONF}$([[ -f "$CONF" ]] && echo '' || echo ' (还没写过, 用的是内置默认值)')"

  if port_alive "$a" "$p"; then
    ok "代理端口 ${a}:${p} 可达"
  else
    warn "代理端口 ${a}:${p} 连不上(代理没开?)"
  fi

  echo
  echo -n "  端口       : "
  if port_alive "$a" "$p"; then echo "${G}通${N}"; else echo "${R}不通${N}"; fi

  echo -n "  终端环境变量: "
  if [[ -n "${http_proxy:-}${https_proxy:-}${all_proxy:-}${HTTP_PROXY:-}${ALL_PROXY:-}" ]]; then
    echo "${G}已设置${N} ${http_proxy:-${https_proxy:-$all_proxy}}"
  else
    # 这个"未设置"曾经长期挂着当正常现象, 其实是个真 bug: /etc/profile.d 只有
    # 登录 shell 读, 而 xfce4-terminal 开的是非登录 shell。现在 ~/.bashrc 里也
    # source 了同一份脚本, 开一个新终端就一定有(端口通不通除外)。
    echo "${Y}未设置${N}(开一个新终端试试: ~/.bashrc 与 ${PROFILE_D} 都会加载它)"
  fi

  echo -n "  apt        : "
  if [[ -f "$APT_CONF" ]]; then
    echo "${G}走代理${N} $(grep -oP 'Acquire::https::Proxy\s+"\K[^"]+' "$APT_CONF" 2>/dev/null)"
  else
    echo "${Y}直连${N}(proxy on 之后走代理)"
  fi

  echo -n "  下载器     : "
  if [[ -f "$DL_CONF" ]]; then
    local pv; pv="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1],encoding="utf-8")).get("proxy",""))' "$DL_CONF" 2>/dev/null)"
    if [[ -n "$pv" ]]; then echo "${G}走代理${N} ${pv}"; else echo "${Y}直连${N}"; fi
  else
    echo "${Y}没找到 config.json${N}"
  fi

  echo -n "  PySocks    : "
  if [[ -x /home/user/.venvs/music/bin/python ]] \
     && /home/user/.venvs/music/bin/python -c "import socks" 2>/dev/null; then
    echo "${G}已安装${N}(music single 可以走 socks5)"
  elif [[ ! -x /home/user/.venvs/music/bin/python ]]; then
    echo "${Y}没有 music 虚拟环境${N}(WITH_PROJECTS=0 的镜像不需要)"
  else
    echo "${Y}未安装${N}(走 socks5 代理会失败, 用 sudo proxy on 补装)"
  fi
}

cmd_test() {
  local url a p target
  url="$(norm_url "${1:-$(read_conf)}")"
  read -r a p <<< "$(host_port "$url")"
  target="${2:-https://www.gstatic.com/generate_204}"

  say "实测: curl 通过 ${url} 访问 ${target}"
  if ! command -v curl >/dev/null 2>&1; then
    die "没装 curl"
  fi
  if ! port_alive "$a" "$p"; then
    die "代理端口 ${a}:${p} 连不上, 先把代理软件开起来"
  fi
  if curl -sS -o /dev/null -w '%{http_code}' --max-time 15 \
        --proxy "$url" "$target" 2>&1 | tail -1 | grep -qE '^(2|3|4)[0-9][0-9]$'; then
    ok "代理可用 ✅"
  else
    warn "代理请求失败, 详细错误:"
    curl -sS -o /dev/null --max-time 15 --proxy "$url" "$target" 2>&1 | sed 's/^/      /'
    exit 1
  fi
}

case "${1:-status}" in
  --print-profile-d)   shift; print_profile_d "$(norm_url "${1:-$(read_conf)}")" ;;
  on)        shift; cmd_on "${1:-}" ;;
  off)       shift; cmd_off ;;
  status|"") cmd_status ;;
  test)      shift; cmd_test "${1:-}" "${2:-}" ;;
  -h|--help|help) usage ;;
  *) echo "未知子命令: $1" >&2; usage >&2; exit 2 ;;
esac