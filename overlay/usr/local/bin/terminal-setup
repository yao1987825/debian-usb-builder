#!/usr/bin/env bash
#
# terminal-setup —— 一次性把"终端体系"配好
#
# 解决用户实测反馈里的三个问题:
#   问题2  "终端的标签切换快捷键不明"
#   问题3  "把所有的终端标签页关闭, 整个画面只有黑乎乎的一片"
#   问题6  "Ctrl+Alt+T 会把整个屏幕都给覆盖了, 把之前的 terminal 都占了"
#
# 做两件事:
#   1) 把 Ctrl+Alt+T 从"开一个新窗口盖住屏幕"改成"在当前窗口里加一个标签页"
#   2) 确认终端守护(terminal-keepalive)装好了 —— 没有面板也没有桌面图标,
#      终端窗口全没了就真的是一片黑, 守护进程是唯一的兜底
#
# 幂等: 随时可以重跑, 不会把自己搞乱。
#
set -uo pipefail

HOME_DIR="${HOME}"
APPS_DIR="${HOME_DIR}/.local/share/applications"
KS_CHANNEL="xfce4-keyboard-shortcuts"
NEW_CMD="/usr/local/bin/terminal-new"
LOG_FILE="${HOME_DIR}/.config/terminal-setup.log"

# --quiet: 开机自启时用, 输出全进日志文件, 不刷屏
QUIET=0
if [[ "${1:-}" == "--quiet" ]]; then
  QUIET=1
  mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
  exec >>"$LOG_FILE" 2>&1
fi

say()  { printf '  %s\n' "$*"; }
ok()   { printf '  \033[1;32m✅\033[0m %s\n' "$*"; }
warn() { printf '  \033[1;33m⚠️\033[0m %s\n' "$*"; }
die()  { printf '  \033[1;31m❌\033[0m %s\n' "$*" >&2; exit 1; }

command -v xfce4-terminal >/dev/null 2>&1 || die "没装 xfce4-terminal"

# ---------------------------------------------------------------------------
# 1) 改 xfconf 里指向终端的快捷键
# ---------------------------------------------------------------------------
# 不去猜 XFCE 把 Ctrl+Alt+T 存在哪个属性名下 —— 直接把 xfconf 里**所有**
# 命令里提到终端的自定义快捷键找出来改掉。属性名里就带着按键,
# 所以命令一改, 按键不用动。
patch_shortcuts() {
  local changed=0 p val
  command -v xfconf-query >/dev/null 2>&1 || return 1
  local props
  props="$(xfconf-query -c "$KS_CHANNEL" -l 2>/dev/null || true)"
  [[ -n "$props" ]] || return 1

  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    [[ "$p" == */command ]] || continue
    val="$(xfconf-query -c "$KS_CHANNEL" -p "$p" 2>/dev/null || true)"
    case "$val" in
      *TerminalEmulator*|*xfce4-terminal*|*terminal-new*)
        [[ "$val" == "$NEW_CMD" ]] && continue
        if xfconf-query -c "$KS_CHANNEL" -p "$p" -n -t string -s "$NEW_CMD" 2>/dev/null; then
          say "快捷键 $p -> $NEW_CMD"
          changed=1
        else
          warn "改不了 $p"
        fi
        ;;
    esac
  done < <(printf '%s\n' "$props")

  [[ $changed -eq 1 ]]
}

# 复查: 还有没有快捷键指向旧命令
verify_shortcuts() {
  command -v xfconf-query >/dev/null 2>&1 || return 0
  local props p val
  props="$(xfconf-query -c "$KS_CHANNEL" -l 2>/dev/null || true)"
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    [[ "$p" == */command ]] || continue
    val="$(xfconf-query -c "$KS_CHANNEL" -p "$p" 2>/dev/null || true)"
    case "$val" in
      *TerminalEmulator*|*xfce4-terminal*) printf '%s = %s\n' "${p##*/}" "$val"; return 1 ;;
    esac
  done < <(printf '%s\n' "$props")
  return 0
}

# ---------------------------------------------------------------------------
# 2) 改桌面项的 Exec(读原文件, 只换 Exec 那一行)
# ---------------------------------------------------------------------------
# 为什么不能整份重写: XFCE 的终端快捷项最终跑的是
#   exo-open --launch TerminalEmulator
# exo-open 是**按桌面项的 Name 字段匹配**的(去掉空格和连字符后比较),
# 所以 Name 一个字都不能改, 只能改 Exec。
# 于是这里的做法是: 把 /usr/share/applications 下的原文件读出来,
# 只把 Exec= 那一行换掉, 其余(Name/Icon/Categories/FullName)原样保留。
#
# 两个文件都要处理:
#   xfce4-terminal-emulator.desktop  ← xfce4-settings 装的, XFCE 快捷项走这个
#   xfce4-terminal.desktop            ← xfce4-terminal 装的, 菜单/面板走这个
override_exec() {
  local src="$1" dst="${APPS_DIR}/$(basename "$1")" changed=0
  [[ -f "$src" ]] || return 1
  mkdir -p "$APPS_DIR" 2>/dev/null || true
  # 用 sed 只替换 Exec= 行, 其余内容一字不动
  if sed -e "s|^Exec=.*|Exec=${NEW_CMD}|" "$src" > "$dst" 2>/dev/null; then
    chmod 0644 "$dst" 2>/dev/null || true
    if grep -q "^Exec=${NEW_CMD}$" "$dst"; then
      changed=1
    fi
  fi
  [[ $changed -eq 1 ]]
}

echo "== 1. 改 Ctrl+Alt+T: 从「新窗口」改成「当前窗口加标签页」 =="
if patch_shortcuts; then
  ok "已把 XFCE 里指向终端的快捷键改成 ${NEW_CMD}"
else
  warn "xfconf 里没找到终端快捷键(或改不动), 下面用桌面项兜底"
fi

_leftover="$(verify_shortcuts 2>/dev/null || true)"
if [[ -z "$_leftover" ]]; then
  ok "复查通过: 没有快捷键还指向旧的 exo-open --launch TerminalEmulator"
else
  warn "还有快捷键指向旧命令, 下面用桌面项兜底:"
  printf '%s\n' "$_leftover" | sed 's/^/       /'
fi

for _d in /usr/share/applications/xfce4-terminal-emulator.desktop \
         /usr/share/applications/xfce4-terminal.desktop; do
  if [[ -f "$_d" ]]; then
    if override_exec "$_d"; then
      ok "已改 Exec: ~/.local/share/applications/$(basename "$_d")"
    else
      warn "改不动: ${_d}"
    fi
  fi
done

# ---------------------------------------------------------------------------
# 3) 终端守护
# ---------------------------------------------------------------------------
echo
echo "== 2. 终端守护(窗口全没了自动拉起) =="
if [[ -x /usr/local/bin/terminal-keepalive ]]; then
  ok "terminal-keepalive 已就位(开机自启)"
  say "想关掉: music terminal off   想恢复: music terminal on"
else
  warn "terminal-keepalive 没装上, 终端全没了得自己重新打开"
fi

echo
echo "完成。键位速查: music keys"
