#!/usr/bin/env bash
#
# music-im-fix —— 把中文输入法修到能用, 或者告诉你差在哪一步
#
# 为什么需要它(im-config 在 Xfce + lightdm 自动登录下经常不生效):
#   im-config 靠的是 ~/.xinputrc + Xsession.d 的钩子。这个链条只要断一环
#   (lightdm 自动登录、xdg-utils 没装、Xsession 脚本顺序变了), GTK/Qt 程序
#   就拿不到 GTK_IM_MODULE, 表现为"输入法装了但中文打不出来 / Shift 没反应"。
#   所以这里不只跑 im-config, 还补两条独立生效的保险:
#     ① ~/.xprofile 里直接导出 IM 环境变量(登录时一定被读)
#     ② ~/.config/autostart/ 里放一个 fcitx5 自启项(不依赖 Xsession 钩子)
#
# 用法:
#   music im-fix          检查 + 修复 + 立刻启动
#   music im-fix --check  只检查不改
#
set -uo pipefail

CHECK_ONLY=0
[[ "${1:-}" == "--check" ]] && CHECK_ONLY=1

RED=$'\033[1;31m'; GRN=$'\033[1;32m'; YEL=$'\033[1;33m'; BLU=$'\033[1;34m'; DIM=$'\033[2m'; RST=$'\033[0m'
say()  { printf '%s[im-fix]%s %s\n' "$BLU" "$RST" "$*"; }
ok()   { printf '  %s✅%s %s\n' "$GRN" "$RST" "$*"; }
bad()  { printf '  %s❌ %s%s\n' "$RED" "$*" "$RST"; BAD=$((BAD+1)); }
warn() { printf '  %s⚠️ %s%s\n' "$YEL" "$*" "$RST"; }
die()  { printf '  %s❌ %s%s\n' "$RED" "$*" "$RST" >&2; exit 1; }
tip()  { printf '     %s→ %s%s\n' "$DIM" "$*" "$RST"; }

HOME_DIR="${HOME:-/home/user}"
BAD=0
say "=== 中文输入法修复 (用户 $(id -un), HOME=${HOME_DIR}) ==="

# ---------------- 0. 必须有图形会话 ----------------
if [[ -z "${DISPLAY:-}" ]]; then
  warn "当前没有 DISPLAY(纯终端)。输入法只在图形界面里有意义"
  tip "请切到图形桌面后在终端里再跑一次; 本次仍会先把配置写好"
fi

# ---------------- 1. fcitx5 装没装 ----------------
if ! command -v fcitx5 >/dev/null 2>&1; then
  if (( CHECK_ONLY )); then
    warn "fcitx5 未安装"
    tip "sudo apt-get install -y fcitx5 fcitx5-rime fcitx5-config-qt im-config rime-data-luna-pinyin fcitx5-chinese-addons"
  else
    say "安装 fcitx5 / fcitx5-rime / 词库 / 拼音引擎 ..."
    if sudo -n apt-get update -qq >/dev/null 2>&1; then
      if sudo -n apt-get install -y --no-install-recommends \
           fcitx5 fcitx5-rime fcitx5-config-qt im-config x11-xserver-utils \
           rime-data-luna-pinyin fcitx5-chinese-addons >/dev/null 2>&1; then
        ok "fcitx5 已安装"
      else
        die "安装失败。手动执行: sudo apt-get install -y fcitx5 fcitx5-rime fcitx5-config-qt rime-data-luna-pinyin fcitx5-chinese-addons"
      fi
    else
      die "apt-get update 失败(可能没网)。联网后重跑: music im-fix"
    fi
  fi
else
  ok "fcitx5 已安装 ($(fcitx5 --version 2>/dev/null | head -1))"
fi

# ---------------- 2. 拼音词库与兜底引擎 ----------------
# 背景: fcitx5-rime 在 Debian 里只硬 Depends 一个几 KB 的 librime-data 元包,
# 真正的拼音词库 rime-data-luna-pinyin 只是 Recommends。用 --no-install-recommends
# 的镜像里它就不在, Rime 部署不出拼音方案, 表现是 fcitx5 图标亮着,
# 但哪里都打不出中文 —— 这是"装了输入法却打不了字"的最常见原因。
RIME_SCHEMA="/usr/share/rime-data/luna_pinyin_simp.schema.yaml"
PINYIN_ADDON="/usr/share/fcitx5/addon/pinyin.conf"
if (( CHECK_ONLY )); then
  if [[ -f "$RIME_SCHEMA" ]]; then
    ok "Rime 拼音词库已安装 (luna_pinyin_simp)"
  else
    bad "Rime 拼音词库缺失 (rime-data-luna-pinyin) —— fcitx5 起来也打不出中文的直接原因"
    tip "sudo apt-get install -y rime-data-luna-pinyin fcitx5-chinese-addons"
  fi
  if [[ -f "$PINYIN_ADDON" ]]; then
    ok "拼音兜底引擎已安装 (fcitx5-chinese-addons 的 pinyin, Rime 失效时可用)"
  else
    warn "拼音兜底引擎没装 (fcitx5-chinese-addons) —— Rime 万一挂了就没有替补"
    tip "sudo apt-get install -y fcitx5-chinese-addons"
  fi
else
  if [[ -f "$RIME_SCHEMA" && -f "$PINYIN_ADDON" ]]; then
    ok "Rime 拼音词库与拼音兜底引擎都已安装"
  else
    say "补装拼音词库/引擎 (rime-data-luna-pinyin / fcitx5-chinese-addons) ..."
    if sudo -n apt-get install -y --no-install-recommends \
         rime-data-luna-pinyin fcitx5-chinese-addons >/dev/null 2>&1 \
    || { sudo -n apt-get update -qq >/dev/null 2>&1 \
      && sudo -n apt-get install -y --no-install-recommends \
           rime-data-luna-pinyin fcitx5-chinese-addons >/dev/null 2>&1; }; then
      ok "词库/引擎已安装"
      # 新词库进来必须让 Rime 重新部署, 否则 build/ 还是部署失败时的旧产物
      RIME_USER_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fcitx5/rime"
      rm -rf "${RIME_USER_DIR}/build"
      if pgrep -x fcitx5 >/dev/null 2>&1; then
        if fcitx5-remote -r >/dev/null 2>&1; then
          ok "已通知 fcitx5 重新部署 Rime (词库编译需要几秒钟)"
        else
          warn "fcitx5-remote -r 没成功, 注销重登一次也能完成部署"
        fi
      else
        warn "fcitx5 没在运行, 重新部署推迟到下次登录"
      fi
    else
      bad "apt 安装失败(可能要密码或没联网)"
      tip "手动执行: sudo apt-get install -y rime-data-luna-pinyin fcitx5-chinese-addons"
    fi
  fi
fi

# ---------------- 3. im-config ----------------
if (( CHECK_ONLY )); then
  if [[ -f "${HOME_DIR}/.xinputrc" ]] && grep -q fcitx5 "${HOME_DIR}/.xinputrc" 2>/dev/null; then
    ok "~/.xinputrc 已指向 fcitx5"
  else
    bad "~/.xinputrc 没指向 fcitx5"
  fi
else
  say "运行 im-config -n fcitx5 ..."
  if command -v im-config >/dev/null 2>&1; then
    im-config -n fcitx5 >/dev/null 2>&1 || warn "im-config 返回非零"
    [[ -f "${HOME_DIR}/.xinputrc" ]] && ok "~/.xinputrc 已写入"
  else
    warn "系统里没有 im-config, 跳过(下面的两条保险仍然生效)"
  fi
fi

# ---------------- 4. 保险①: ~/.xprofile 直接导出 IM 环境变量 ----------------
# Xsession 钩子断了也能生效 —— Xfce 登录时会读 .xprofile
XPROF="${HOME_DIR}/.xprofile"
if (( CHECK_ONLY )); then
  if [[ -f "$XPROF" ]] && grep -q GTK_IM_MODULE "$XPROF" 2>/dev/null; then
    ok "~/.xprofile 里已导出 IM 环境变量"
  else
    bad "~/.xprofile 里没有 IM 环境变量"
  fi
else
  mkdir -p "$HOME_DIR"
  if [[ -f "$XPROF" ]]; then cp "$XPROF" "${XPROF}.bak-$(date +%s)"; fi
  # 去掉旧的 IM 相关行, 再统一写入, 保证不重复堆积
  if [[ -f "$XPROF" ]]; then
    sed -i '/GTK_IM_MODULE/d;/QT_IM_MODULE/d;/XMODIFIERS/d;/^# --- fcitx5 ---$/d' "$XPROF"
  fi
  cat >> "$XPROF" <<'EOF'
# --- fcitx5 ---
export GTK_IM_MODULE=fcitx
export QT_IM_MODULE=fcitx
export XMODIFIERS=@im=fcitx
EOF
  ok "~/.xprofile 已导出 GTK_IM_MODULE / QT_IM_MODULE / XMODIFIERS"
fi

# ---------------- 5. 保险②: 自启项 ----------------
AUTOSTART_DIR="${HOME_DIR}/.config/autostart"
DESKTOP="${AUTOSTART_DIR}/fcitx5.desktop"
if (( CHECK_ONLY )); then
  if [[ -f "$DESKTOP" ]]; then
    ok "fcitx5 自启项存在"
  else
    bad "fcitx5 自启项不存在"
  fi
else
  mkdir -p "$AUTOSTART_DIR"
  cat > "$DESKTOP" <<'EOF'
[Desktop Entry]
Type=Application
Name=Fcitx 5
Comment=启动 fcitx5 输入法
Exec=fcitx5 -d --replace
Icon=fcitx
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
  ok "已写入 ${DESKTOP}"
fi

# ---------------- 6. 立刻启动 ----------------
if command -v fcitx5 >/dev/null 2>&1; then
  if pgrep -x fcitx5 >/dev/null 2>&1; then
    ok "fcitx5 正在运行"
  elif (( CHECK_ONLY )); then
    bad "fcitx5 没在运行"
  elif [[ -z "${DISPLAY:-}" ]]; then
    warn "没有 DISPLAY, 没法在这里启动(登录图形界面时会自启)"
  else
    say "立即启动 fcitx5 ..."
    # 先在当前 shell 里导出, 否则 fcitx5 起来也找不到 D-Bus 之外的依赖
    export GTK_IM_MODULE=fcitx QT_IM_MODULE=fcitx XMODIFIERS=@im=fcitx
    ( fcitx5 -d --replace >/dev/null 2>&1 & )
    sleep 2
    if pgrep -x fcitx5 >/dev/null 2>&1; then
      ok "fcitx5 已启动"
    else
      bad "fcitx5 启动失败, 手动跑一次看报错: fcitx5"
    fi
  fi
fi

# ---------------- 7. 收尾 ----------------
echo
if (( CHECK_ONLY )); then
  say "以上为检查结果(没有做任何修改)。要修复就跑: music im-fix"
else
  say "修好了。现在测一下:"
  echo "    1) 打开一个文本框(比如 mousepad), 按 Ctrl+Space 激活输入法"
  echo "    2) 输入 nihao 应该出候选; 按 Ctrl+9 或 Ctrl+0 选词"
  echo "    3) 单独按 Shift 切中英文(Rime 的 ascii_composer)"
  echo
  warn "当前这个终端的环境变量是旧的。如果第 1 步没反应, 注销重新登录一次:"
  echo "    xfce4-session-logout --logout    # 或菜单里选 注销"
  echo "    然后用图形界面重新登录, 再跑一次 music-health 确认"
fi