#!/usr/bin/env bash
#
# terminal-welcome —— 开机自动弹出的那个终端
#
# 用户的设想: "插入u盘读取系统, 像黑客一样, 在终端下操作" ——
# 登录第一眼就是终端, 一眼看出这是什么系统(YAO*OS)。
#
# 2026-11-07 改版: 开机不再打键位速查表(用户: "不需要一开机就显示终端
# 一些说明"), 改成 YAO*OS 横幅 + 一行 help 提示。速查表没删 ——
# 随时 `terminal-keys`(或 `music keys`)手动看, `help` 看全部命令。
#
# 注意: 终端的 autostart 项里已经等过 fcitx5 就绪
# (等 org.fcitx.Fcitx5 出现在 session bus 上, 见 build-image.sh),
# 那个等待解决的是"开机首个窗口终身打不出中文"的竞态问题。
# 这里只负责开窗口 + 打系统横幅。
#
set -uo pipefail

# YAO*OS 横幅: 纯文本边框, 不依赖 figlet/toilet(镜像里没装)。
# 全绿描边 + 加粗系统名, 一行 dim 提示怎么查功能。
printf '\n'
printf '  \033[1;32m╔═══════════════════════════════════╗\n'
printf '  ║                                   ║\n'
printf '  ║      Y A O * O S                  ║\n'
printf '  ║                                   ║\n'
printf '  ╚═══════════════════════════════════╝\033[0m\n'
printf '\n'
printf '  \033[2m输入 help 查看系统功能\033[0m\n'
printf '\n'

exec "${SHELL:-/bin/bash}"
