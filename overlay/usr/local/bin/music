#!/usr/bin/env bash
#
# music —— 歌曲下载快捷入口 (命令行优先)
#
#   music single "周杰伦 夜曲"      搜索并下载单曲到歌曲分区   ★最常用
#   music single "夜曲" --list      只看候选, 不下载
#   music single "夜曲" --index 2   下载第 2 条候选
#   music search "夜曲"             等同 single --list
#   music playlist playlist.csv     按歌单 CSV 批量下载
#   music gui                       图形界面 (需 PyQt6, 轻量镜像未装)
#   music out                       打印歌曲分区路径
#   music ls                        列出已下载的歌曲
#   music which                     打印各组件路径
#   music net                       网络自检
#   music proxy [status|on|off]      代理开关
#   music screen                    自动匹配显示器原生分辨率
#   music health                    一键体检(不确定哪里坏了就跑这个)
#   music im-fix                    修复中文输入法
#   music doctor                    环境自检
#   music setup-gui                 补装 PyQt6 (启用图形界面)
#   music setup-playwright          补装 Playwright Chromium
#
set -Eeuo pipefail

SONG_DIR="${SONG_DIR:-/mnt/songdisk}"
HOME_DIR="${HOME:-/home/user}"
PROJ_GUI="${PROJ_GUI:-${HOME_DIR}/projects/gequhai-downloader}"
PROJ_LIST="${PROJ_LIST:-${HOME_DIR}/projects/gequhai-playlist-downloader}"
VENV_MUSIC="${VENV_MUSIC:-${HOME_DIR}/.venvs/music}"
VENV_GUI="${VENV_GUI:-${HOME_DIR}/.venvs/gequhai-gui}"
VENV_LIST="${VENV_LIST:-${HOME_DIR}/.venvs/playlist}"
SINGLE_PY="${SINGLE_PY:-/usr/local/lib/musictools/single.py}"
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-${HOME_DIR}/.cache/ms-playwright}"

usage() {
  cat <<'EOF'
用法: music <子命令> [参数]

  music single "周杰伦 夜曲"      搜索并下载单曲到歌曲分区   ★最常用
  music single "夜曲" --list      只看候选, 不下载
  music single "夜曲" --index 2   下载第 2 条候选
  music search "夜曲"             等同 single --list
  music playlist playlist.csv     按歌单 CSV 批量下载
  music gui                       图形界面 (需 PyQt6, 轻量镜像未装)
  music net                       网络自检 (连不上网先跑这个)
  music net --fix                 网络自检 + 自动修复
  music proxy [status|on|off]      代理开关 (等同于 proxy 命令)
  music screen [--list]           自动匹配每块显示器的原生分辨率
  music health                  一键体检: 输入法/分辨率/分区/权限/网络/夸克Cookie
  music health --fix            体检 + 自动修能安全修的
  music im-fix                  修复中文输入法(装了但打不出中文/Shift 没反应)
  music setup-proxy [地址]        设置代理 (等同 music proxy on <地址>)
  music setup-proxy off           清空代理 (等同 music proxy off)
  music out                       打印歌曲分区路径
  music ls                        列出已下载的歌曲
  music which                     打印各组件路径
  music doctor                    环境自检
  music setup-gui                 补装 PyQt6 (启用图形界面)
  music setup-playwright          补装 Playwright Chromium (需 root)
EOF
}

# ---------------- 歌曲分区预检 ----------------
songdisk_check() {
  local dir="${SONG_DIR}"
  if [[ ! -d "$dir" ]]; then
    echo "错误: 歌曲分区目录不存在: ${dir}" >&2
    echo "      请确认 U 盘已正确写入镜像 (Rufus 需选 DD 模式)" >&2
    return 1
  fi
  if ! mountpoint -q "$dir" 2>/dev/null; then
    echo "警告: ${dir} 当前不是挂载点" >&2
    if command -v mount >/dev/null 2>&1; then
      if sudo -n mount "$dir" 2>/dev/null; then
        echo "      已自动挂载" >&2
      else
        echo "      自动挂载失败, 请手动执行: sudo mount ${dir}" >&2
        return 1
      fi
    fi
  fi
  if [[ ! -w "$dir" ]]; then
    echo "错误: 歌曲分区不可写: ${dir}" >&2
    return 1
  fi
  return 0
}

# ---------------- 单曲下载 ----------------
# 注意: 调用方(case 分支)已经 shift 掉子命令名了, 这里不能再 shift,
# 否则第一个参数(关键词)会被吃掉, 变成 "music single --list" 搜不到东西。
cmd_single() {
  [[ $# -ge 1 ]] || { echo "用法: music single <关键词> [--list] [--index N]" >&2; return 2; }
  # 第一个参数是选项就说明关键词没写, 别把 "--list" 当成歌名去搜
  case "${1:-}" in
    -*) echo "用法: music single <关键词> [--list] [--index N]" >&2; return 2 ;;
  esac
  songdisk_check || return 1
  if [[ ! -x "${VENV_MUSIC}/bin/python" ]]; then
    echo "错误: 缺少 ${VENV_MUSIC} (单曲下载只依赖 requests)" >&2
    echo "      修复: python3 -m venv ${VENV_MUSIC} && ${VENV_MUSIC}/bin/pip install requests" >&2
    return 1
  fi
  exec "${VENV_MUSIC}/bin/python" "${SINGLE_PY}" "$@"
}

cmd_search() {
  [[ $# -ge 1 ]] || { echo "用法: music search <关键词>" >&2; return 2; }
  cmd_single "$@" --list
}

# ---------------- 歌单批量 ----------------
cmd_playlist() {
  local csv="${1:-playlist.csv}"
  [[ $# -gt 0 ]] && shift || true
  songdisk_check || return 1
  cd "$PROJ_LIST" 2>/dev/null || { echo "错误: 找不到项目目录: $PROJ_LIST" >&2; return 1; }
  [[ -f "$csv" ]] || { echo "错误: 找不到歌单 CSV: $csv" >&2; return 1; }
  if [[ ! -x "${VENV_LIST}/bin/python" ]]; then
    echo "错误: 缺少 ${VENV_LIST}" >&2
    echo "      修复: python3 -m venv ${VENV_LIST} && ${VENV_LIST}/bin/pip install -r ${PROJ_LIST}/requirements.txt" >&2
    return 1
  fi
  echo "[music] 歌单: ${csv}"
  echo "[music] 输出: ${SONG_DIR}"
  "${VENV_LIST}/bin/python" gequhai_downloader.py --csv "$csv" --out "$SONG_DIR" "$@"
  local rc=$?
  if [[ $rc -eq 0 ]]; then
    echo "[music] 转码 aac/acc → mp3 ..."
    "${VENV_LIST}/bin/python" convert_aac_to_mp3.py --dir "$SONG_DIR" || true
  fi
  return $rc
}

# ---------------- 图形界面 ----------------
cmd_gui() {
  if [[ ! -x "${VENV_GUI}/bin/python" ]]; then
    echo "图形界面未安装 (轻量镜像默认不含 PyQt6)" >&2
    echo "启用方法: music setup-gui" >&2
    return 1
  fi
  if ! "${VENV_GUI}/bin/python" -c "import PyQt6" 2>/dev/null; then
    echo "PyQt6 未安装, 无法启动图形界面" >&2
    echo "启用方法: music setup-gui" >&2
    return 1
  fi
  cd "$PROJ_GUI" 2>/dev/null || { echo "错误: 找不到项目目录: $PROJ_GUI" >&2; return 1; }
  echo "[music] 图形界面已启动, 搜索框里可直接输入中文歌名"
  exec "${VENV_GUI}/bin/python" main.py
}

cmd_setup_gui() {
  echo "[music] 创建图形界面虚拟环境 ${VENV_GUI} ..."
  python3 -m venv "$VENV_GUI"
  "${VENV_GUI}/bin/pip" install --disable-pip-version-check --no-cache-dir -q PyQt6 requests
  echo "[music] 完成, 现在可以运行: music gui"
}

cmd_setup_playwright() {
  echo "[music] 安装 Playwright Chromium (约 500MB, 需要联网) ..."
  # --with-deps 会调 apt-get 装系统依赖, 必须 root
  if [[ "$(id -u)" != "0" ]]; then
    echo "[music] 需要 root(要装 Chromium 的系统依赖), 请执行: sudo music setup-playwright" >&2
    return 1
  fi
  if [[ ! -x "${VENV_LIST}/bin/python" ]]; then
    echo "错误: 缺少 ${VENV_LIST}" >&2
    echo "      修复: python3 -m venv ${VENV_LIST} && ${VENV_LIST}/bin/pip install -r ${PROJ_LIST}/requirements.txt" >&2
    return 1
  fi
  # 浏览器装到 root 家目录会跟普通用户对不上, 统一装到 /home/user 下
  export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-${HOME_DIR}/.cache/ms-playwright}"
  "${VENV_LIST}/bin/python" -m playwright install --with-deps chromium
  echo "[music] 完成"
}

# ---------------- 网络 ----------------
cmd_net() {
  if [[ -x /usr/local/bin/net-doctor ]]; then
    exec /usr/local/bin/net-doctor "$@"
  fi
  echo "错误: 找不到 /usr/local/bin/net-doctor" >&2
  return 1
}

# ---------------- 代理 ----------------
# 代理的真正实现在 /usr/local/bin/proxy: 它要同时管 apt 配置、下载器配置、
# 终端环境变量和 PySocks, 塞在这里只会让 music 变成一个什么都干的大脚本。
cmd_proxy() {
  if [[ ! -x /usr/local/bin/proxy ]]; then
    echo "错误: 找不到 /usr/local/bin/proxy" >&2
    return 1
  fi
  exec /usr/local/bin/proxy "$@"
}

cmd_setup_proxy() {
  # 兼容旧用法: music setup-proxy [地址] | music setup-proxy off
  local arg="${1:-}"
  case "$arg" in
    off|--off|clear) cmd_proxy off ;;
    "")              cmd_proxy status ;;
    *)               cmd_proxy on "$arg" ;;
  esac
}

# ---------------- 显示分辨率 ----------------
cmd_screen() {
  if [[ ! -x /usr/local/bin/screen-fit ]]; then
    echo "错误: 找不到 /usr/local/bin/screen-fit" >&2
    return 1
  fi
  exec /usr/local/bin/screen-fit "$@"
}

# ---------------- 体检 / 修输入法 ----------------
cmd_health() {
  if [[ ! -x /usr/local/bin/music-health ]]; then
    echo "错误: 找不到 /usr/local/bin/music-health" >&2
    return 1
  fi
  exec /usr/local/bin/music-health "$@"
}

cmd_im_fix() {
  if [[ ! -x /usr/local/bin/music-im-fix ]]; then
    echo "错误: 找不到 /usr/local/bin/music-im-fix" >&2
    return 1
  fi
  exec /usr/local/bin/music-im-fix "$@"
}

# ---------------- 其他 ----------------
cmd_doctor() {
  echo "=== music 环境自检 ==="
  printf '%-22s %s\n' "歌曲分区" "${SONG_DIR}"
  if [[ -d "$SONG_DIR" ]]; then
    if mountpoint -q "$SONG_DIR" 2>/dev/null; then
      printf '%-22s %s\n' "  挂载状态" "✅ 已挂载"
    else
      printf '%-22s %s\n' "  挂载状态" "⚠️  未挂载"
    fi
    if [[ -w "$SONG_DIR" ]]; then
      printf '%-22s %s\n' "  可写" "✅"
    else
      printf '%-22s %s\n' "  可写" "❌ 不可写"
    fi
    df -h "$SONG_DIR" 2>/dev/null | tail -1 | sed 's/^/  /'
  else
    printf '%-22s %s\n' "  状态" "❌ 目录不存在"
  fi

  printf '%-22s %s\n' "单曲下载 venv" "$VENV_MUSIC"
  if [[ -x "${VENV_MUSIC}/bin/python" ]]; then
    printf '%-22s %s\n' "  状态" "✅ 可用 (music single)"
  else
    printf '%-22s %s\n' "  状态" "⚠️  缺失, 单曲下载不可用"
  fi

  printf '%-22s %s\n' "歌单 venv" "$VENV_LIST"
  if [[ -x "${VENV_LIST}/bin/python" ]]; then
    printf '%-22s %s\n' "  状态" "✅ 可用 (music playlist)"
    if [[ -d "${PLAYWRIGHT_BROWSERS_PATH}" ]]; then
      printf '%-22s %s\n' "  Chromium" "✅ 已安装"
    else
      printf '%-22s %s\n' "  Chromium" "⚠️  未安装(仅静态搜索), music setup-playwright"
    fi
  else
    printf '%-22s %s\n' "  状态" "⚠️  缺失, 批量下载不可用"
  fi

  printf '%-22s %s\n' "图形界面 venv" "$VENV_GUI"
  if [[ -x "${VENV_GUI}/bin/python" ]] && "${VENV_GUI}/bin/python" -c "import PyQt6" 2>/dev/null; then
    printf '%-22s %s\n' "  状态" "✅ 可用 (music gui)"
  else
    printf '%-22s %s\n' "  状态" "ℹ️  未安装(轻量镜像), music setup-gui"
  fi

  printf '%-22s %s\n' "输入法" "$(command -v fcitx5 >/dev/null 2>&1 && echo '✅ fcitx5 已安装' || echo '❌ 未安装')"
  printf '%-22s %s\n' "ffmpeg" "$(command -v ffmpeg >/dev/null 2>&1 && echo '✅ 已安装' || echo '⚠️  未安装(无法转码 mp3)')"

  # 网络: 下载能不能用, 先看这几项
  printf '%-22s %s\n' "" "---- 网络 ----"
  if command -v nmcli >/dev/null 2>&1; then
    printf '%-22s %s\n' "NetworkManager" "$(systemctl is-active NetworkManager >/dev/null 2>&1 && echo '✅ 运行中' || echo '❌ 没运行 -> sudo systemctl enable --now NetworkManager')"
  else
    printf '%-22s %s\n' "NetworkManager" "❌ 未安装(没有它就没有网络)"
  fi
  if command -v ip >/dev/null 2>&1; then
    local ips; ips="$(ip -o -4 addr show scope global 2>/dev/null | awk '{print $2" "$4}' | tr '\n' ' ')"
    printf '%-22s %s\n' "网卡 IP" "${ips:-❌ 没有任何网卡拿到地址(检查网线/WiFi)}"
    printf '%-22s %s\n' "默认路由" "$(ip route show default 2>/dev/null | head -1 || echo '❌ 没有默认路由')"
  fi
  if getent hosts www.baidu.com >/dev/null 2>&1; then
    printf '%-22s %s\n' "域名解析" "✅ 正常"
  else
    printf '%-22s %s\n' "域名解析" "❌ 失败(跑 music net 看详情)"
  fi
  printf '%-22s %s\n' "  代理" "$(env | grep -qiE '^(http|https)_proxy=' && echo '⚠️  当前 shell 设了代理' || echo '无')"
  echo "  详细诊断: music net   自动修复: music net --fix"
  if ! command -v nmcli >/dev/null 2>&1; then
    echo "  连不上网且装不了 NetworkManager 时: sudo net-rescue"
  fi
  echo "  代理开关: music proxy status   (socks5://192.168.6.1:1070)"

  # 显示: 每块屏各用各的原生分辨率, 插到不同显示器上才不会是拉伸的
  printf '\n%-22s %s\n' "" "---- 显示 ----"
  if command -v xrandr >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
    local _o _line
    while read -r _o _line; do
      [[ "$_o" == "connected" ]] || continue
      local _name="${_o%% *}" _res
      _res="$(printf '%s' "$_line" | grep -oE '[0-9]+x[0-9]+' | head -1)"
      printf '%-22s %s\n' "${_name}" "${_res:-?} (screen-fit 会自动改成原生分辨率)"
    done < <(xrandr --query 2>/dev/null | grep ' connected ')
    echo "  自动匹配原生分辨率: music screen"
  else
    printf '%-22s %s\n' "显示" "ℹ️  没有图形会话(纯命令行), 不涉及分辨率"
  fi
  echo
}

case "${1:-}" in
  single|download|dl)  shift; cmd_single "$@" ;;
  search|find)         shift; cmd_search "$@" ;;
  playlist|batch)      shift; cmd_playlist "$@" ;;
  gui)                 shift; cmd_gui "$@" ;;
  out)                 echo "$SONG_DIR" ;;
  ls|list)             songdisk_check && ls -lh "$SONG_DIR" 2>/dev/null | head -60 ;;
  which)
    printf '单曲 venv   : %s\n' "$VENV_MUSIC"
    printf '图形 venv   : %s\n' "$VENV_GUI"
    printf '歌单 venv   : %s\n' "$VENV_LIST"
    printf '图形项目    : %s\n' "$PROJ_GUI"
    printf '歌单项目    : %s\n' "$PROJ_LIST"
    printf '歌曲目录    : %s\n' "$SONG_DIR"
    ;;
  doctor)              cmd_doctor ;;
  net)                 shift; cmd_net "$@" ;;
  proxy)               shift; cmd_proxy "$@" ;;
  screen|display|res)  shift; cmd_screen "$@" ;;
  health|check-all)    shift; cmd_health "$@" ;;
  im-fix|imfix)        shift; cmd_im_fix "$@" ;;
  setup-proxy)         shift; cmd_setup_proxy "$@" ;;
  setup-gui)           cmd_setup_gui ;;
  setup-playwright)    cmd_setup_playwright ;;
  ""|-h|--help|help)   usage ;;
  *) echo "未知命令: $1" >&2; echo >&2; usage >&2; exit 2 ;;
esac
