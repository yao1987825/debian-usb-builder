#!/usr/bin/env bash
#
# music-health —— 一次性把"到底哪里不对"全查清楚, 打印成一段可以直接粘贴回来的报告
#
# 为什么需要它:
#   真机上出问题的时候, 最费时间的不是修, 是"不知道到底哪里坏了"。
#   输入法没反应, 可能是没装、没起、没配、也可能你压根不在图形界面里;
#   分辨率不对, 可能是没跑 screen-fit, 也可能是 EDID 读不到, 还可能是
#   你在 TTY 里执行、根本没有 X。这几件事的排查命令散在四个脚本里。
#
# 用法:
#   music-health          只报告, 不改任何东西
#   music-health --fix    报告 + 自动修能安全修的(重跑 im-config / 打开 screen-fit 自启)
#
# 输出末尾会提示你把整段发回来。
#
set -uo pipefail

FIX=0
[[ "${1:-}" == "--fix" ]] && FIX=1

RED=$'\033[1;31m'; GRN=$'\033[1;32m'; YEL=$'\033[1;33m'; BLU=$'\033[1;34m'; DIM=$'\033[2m'; RST=$'\033[0m'
ok()   { printf '  %s✅%s %s\n' "$GRN" "$RST" "$*"; }
bad()  { printf '  %s❌%s %s\n' "$RED" "$RST" "$*"; BAD=$((BAD+1)); }
warn() { printf '  %s⚠️ %s%s\n' "$YEL" "$*" "$RST"; }
info() { printf '  %s·%s %s\n' "$BLU" "$RST" "$*"; }
tip()  { printf '     %s→ %s%s\n' "$DIM" "$*" "$RST"; }
sect() { printf '\n%s========== %s ==========%s\n' "$BLU" "$*" "$RST"; }
BAD=0

GUESSED_HINTS=""

printf '%s=== 系统体检 ===%s\n' "$BLU" "$RST"
printf '时间: %s\n' "$(date -Is)"
printf '主机: %s   内核: %s\n' "$(hostname 2>/dev/null || echo '?')" "$(uname -sr 2>/dev/null || echo '?')"

############################## 0. 会话类型 ##############################
# 这一段最重要: 输入法和分辨率的问题, 十有八九是因为"你根本不在图形界面里"。
sect "0. 你现在在图形界面还是终端(TTY)？"
info "DISPLAY        = ${DISPLAY:-<空>}"
info "XDG_SESSION_TYPE = ${XDG_SESSION_TYPE:-<空>}"
info "XDG_CURRENT_DESKTOP = ${XDG_CURRENT_DESKTOP:-<空>}"
info "SSH_CONNECTION  = ${SSH_CONNECTION:-<空>}"
info "TERM           = ${TERM:-<空>}"
if [[ -z "${DISPLAY:-}" ]]; then
  bad "当前没有 DISPLAY —— 你在纯终端(TTY / SSH)里"
  tip "输入法(中文/Shift)和分辨率在这里面统统不会有反应, 这是正常的"
  tip "切回图形桌面: 拔插显示器, 或按 Ctrl+Alt+F2~F6 换到图形会话"
  tip "在图形界面里打开一个终端(xfce4-terminal), 再跑一次 music-health"
  GUESSED_HINTS="${GUESSED_HINTS}本次运行没有 DISPLAY, 输入法与分辨率的结论请以图形界面下的运行结果为准\n"
else
  ok "有图形会话 (DISPLAY=${DISPLAY})"
fi

############################## 1. 中文输入法 ##############################
sect "1. 中文输入法 (fcitx5 + Rime)"
if ! command -v fcitx5 >/dev/null 2>&1; then
  bad "fcitx5 没安装"
  tip "sudo apt-get install -y fcitx5 fcitx5-rime fcitx5-config-qt im-config rime-data-luna-pinyin fcitx5-chinese-addons"
else
  ok "fcitx5 已安装 ($(fcitx5 --version 2>/dev/null | head -1))"
fi

# 拼音词库最容易被漏装(fcitx5-rime 对它只是 Recommends, 不用 Install-Recommends
# 装就刚好没有), 没有 fcitx5 照样启动, 但哪里都打不出中文
if [[ -f /usr/share/rime-data/luna_pinyin_simp.schema.yaml ]]; then
  ok "Rime 拼音词库已安装 (luna_pinyin_simp)"
else
  bad "Rime 拼音词库没装 (rime-data-luna-pinyin) —— 这就是哪里都打不出中文的直接原因"
  tip "sudo apt-get install -y rime-data-luna-pinyin fcitx5-chinese-addons"
  tip "装完跑: music im-fix   (它会清掉部署产物并让 fcitx5 重新部署)"
fi

if pgrep -a fcitx5 >/dev/null 2>&1; then
  ok "fcitx5 进程正在运行: $(pgrep -a fcitx5 | head -1 | cut -c1-120)"
else
  bad "fcitx5 进程没有运行 —— 这就是「中文输入法没启用」的直接原因"
  tip "图形界面里执行: fcitx5 -d   或跑 music im-fix"
fi

if command -v fcitx5-remote >/dev/null 2>&1; then
  _im="$(fcitx5-remote -n 2>/dev/null || true)"
  if [[ -z "$_im" ]]; then
    bad "fcitx5-remote 报不到当前输入法(fcitx5 没连上 DBus?)"
    tip "检查 DBUS_SESSION_BUS_ADDRESS 是否为空: ${DBUS_SESSION_BUS_ADDRESS:-<空>}"
  else
    ok "当前输入法: ${_im}"
  fi
  if fcitx5-remote -q >/dev/null 2>&1; then
    info "输入法当前处于: 激活"
  else
    warn "输入法处于关闭状态 —— 按 Ctrl+Space 激活"
  fi
  # fcitx5-remote 不带参数会返回状态码, 用来解释"按 Shift 没反应":
  #   0 = 关闭       1 = Inactive(英文态)   2 = Active(中文态)
  # 关键: 处于 **英文态(1)** 时按键根本不经过输入法, Rime 收不到 Shift,
  # 所以"按 Shift 没反应"其实是状态问题, 不是配置问题(配置是逐项校验过的)。
  _st="$(fcitx5-remote 2>/dev/null || echo 0)"
  case "$_st" in
    2) ok "当前是中文态(Active) —— 此时按 Shift 可以快速切中英" ;;
    1) warn "当前是英文态(Inactive) —— 此时按 Shift/CapsLock 都不会切换, 因为按键不经过输入法"
       tip "按 Ctrl+Space 切回中文, 或执行: music im-toggle(不看你当前状态, 直接切)" ;;
    0) warn "fcitx5 当前是关闭状态(0) —— 任何切换键都没用, 先按 Ctrl+Space 或跑 music im-fix" ;;
    *) warn "fcitx5 状态码异常: ${_st}" ;;
  esac
fi

info "环境变量:"
printf '     GTK_IM_MODULE = %s\n' "${GTK_IM_MODULE:-<空>}"
printf '     QT_IM_MODULE  = %s\n' "${QT_IM_MODULE:-<空>}"
printf '     XMODIFIERS    = %s\n' "${XMODIFIERS:-<空>}"
for v in GTK_IM_MODULE QT_IM_MODULE XMODIFIERS; do
  if [[ -z "${!v:-}" ]]; then
    bad "$v 没设置 —— GTK/Qt 程序里根本不会走 fcitx5"
    GUESSED_HINTS="${GUESSED_HINTS}${v} 没设置, 说明 im-config 没生效\n"
  fi
done

# 真机 v1.0.2 "输入法切不动"的根因就是这两个文件属主成了 root —— 读得到、
# 写不进去, fcitx5 切换时写状态失败, 于是表现为"有时能切有时不能"。
# 必须在体检里查出来, 否则用户只会以为输入法坏了。
FC_DIR="${HOME}/.config/fcitx5"
for f in "${FC_DIR}/profile" "${FC_DIR}/config"; do
  if [[ ! -e "$f" ]]; then
    warn "$f 不存在(fcitx5 会用默认配置, 快捷键可能不是 Ctrl+Space)"
  elif [[ ! -w "$f" ]]; then
    bad "$f 当前用户写不进去(属主 $(stat -c '%U' "$f" 2>/dev/null || echo '?')) —— 这是输入法切不动最常见的原因"
    tip "修复: sudo chown -R \$(id -un):\$(id -gn) ${FC_DIR} && music im-fix"
  fi
done

# 前端包缺失时, 终端等 GTK 程序里 Ctrl+Space 完全没反应(只有输入法框架在跑)
for p in fcitx5-frontend-gtk3 fcitx5-frontend-qt5; do
  if ! dpkg -s "$p" >/dev/null 2>&1; then
    bad "$p 没装 —— GTK/Qt 程序里输入法用不了(Ctrl+Space 无反应)"
    tip "sudo apt-get install -y $p"
  fi
done

HOMEDIR="$(eval echo "~$(id -un)")"
if [[ -f "${HOMEDIR}/.xinputrc" ]]; then
  ok "~/.xinputrc 存在"
  sed 's/^/       /' "${HOMEDIR}/.xinputrc"
  if ! grep -q "fcitx5" "${HOMEDIR}/.xinputrc" 2>/dev/null; then
    bad "~/.xinputrc 里没有 fcitx5"
    tip "im-config -n fcitx5   然后注销重登"
  fi
else
  bad "~/.xinputrc 不存在 —— im-config 从没配过"
  tip "im-config -n fcitx5   然后注销重登(改完必须重登, 不重登不生效)"
fi

# Rime 的用户目录是 ~/.local/share/fcitx5/rime/ —— 放在 ~/.config/fcitx5/rime/
# 下 Rime 根本不看(真机 v1.0.4 的坑: 配置从没生效过)。
RIME="${HOMEDIR}/.local/share/fcitx5/rime"
if [[ -f "${HOMEDIR}/.config/fcitx5/profile" ]]; then
  ok "fcitx5 profile 存在"
  grep -E '^(DefaultIM|Enable)=' "${HOMEDIR}/.config/fcitx5/profile" 2>/dev/null | sed 's/^/       /'
else
  bad "fcitx5 profile 不存在"
fi
# 当前输入法: 真机 v1.0.4 的坑 —— fcitx5 起来后默认是 keyboard-us(直写态),
# 这时按 Shift 根本没人接管, 用户只会觉得"输入法坏了"。
if command -v fcitx5-remote >/dev/null 2>&1; then
  _im="$(fcitx5-remote -n 2>/dev/null || true)"
  if [[ "$_im" == "rime" ]]; then
    ok "当前输入法是 rime(按 Shift 可切中英)"
  elif [[ -n "$_im" ]]; then
    bad "当前输入法是 ${_im}, 不是 rime —— 按 Shift 不会有反应(跑 music im-fix 或重登)"
    tip "切到中文态: fcitx5-remote -s rime"
  fi
fi

for f in default.custom.yaml user.dict.yaml; do
  if [[ -f "${RIME}/${f}" ]]; then
    ok "Rime 配置 ${f} 存在"
  else
    warn "Rime 配置 ${f} 不存在"
  fi
done
# Shift 切中英文靠的是 Rime 的 ascii_composer 开关, 这一项最容易被忽略
if [[ -f "${RIME}/default.custom.yaml" ]]; then
  # 正确写法是扁平键 "ascii_composer/switch_key/Shift_L": inline_ascii
  # 正则里的 "?" 不能省 —— YAML 的 key 带引号, 冒号前面还有一个引号。
  # 少了它这个分支永远不成立, 会把**配置正确**的镜像误报成"Shift 永远不会生效"。
  if grep -qE 'ascii_composer/switch_key/(Shift_L|Shift_R)"?: inline_ascii' "${RIME}/default.custom.yaml"; then
    ok "Rime 的 Shift 切中英文: 已配置(inline_ascii, 扁平键写法)"
  elif grep -q 'ascii_composer/switch_key' "${RIME}/default.custom.yaml"; then
    bad "Rime 的 ascii_composer 写成了字符串而不是键->动作映射, Shift 永远不会生效"
    tip '正确写法: "ascii_composer/switch_key/Shift_L": inline_ascii'
    GUESSED_HINTS="${GUESSED_HINTS}Rime 的 Shift 切换配置写错了(应该是扁平键 switch_key/Shift_L)\n"
  else
    warn "Rime 配置里没有 ascii_composer —— 按 Shift 不会切中英文"
  fi
fi

############################## 2. 终端 ##############################
# 用户实测反馈的三条都跟终端有关:
#   "终端的标签切换快捷键不明" / "关掉所有标签页就黑屏" / "Ctrl+Alt+T 盖住整个屏幕"
# 这一节就是让用户一眼看出"现在终端是什么状态、少了哪一环"。
sect "2. 终端(标签页 / 守护 / 键位)"

for _t in terminal-keepalive terminal-new terminal-keys terminal-setup terminal-welcome; do
  if [[ -x "/usr/local/bin/${_t}" ]]; then
    ok "/usr/local/bin/${_t} 存在"
  else
    bad "/usr/local/bin/${_t} 不存在 —— 终端体系没装全"
  fi
done

if [[ -f "${HOMEDIR}/.config/xfce4/terminal/terminalrc" ]]; then
  if grep -q 'Shortcuts=NextTab' "${HOMEDIR}/.config/xfce4/terminal/terminalrc" \
     && grep -q 'Shortcuts=PrevTab' "${HOMEDIR}/.config/xfce4/terminal/terminalrc"; then
    ok "标签页切换快捷键已显式配置(Ctrl+Page_Down / Ctrl+Page_Up)"
  else
    bad "终端配置里没有标签页切换快捷键"
    tip "跑 music terminal setup 重新生成"
  fi
else
  bad "没有终端配置 terminalrc"
fi

if [[ -f "${HOMEDIR}/.config/autostart/terminal-keepalive.desktop" ]]; then
  ok "终端守护自启项在(窗口全没了会自动拉起)"
else
  bad "终端守护自启项不在 —— 关掉所有终端后会黑屏"
fi
if pgrep -f "terminal-keepalive --daemon" >/dev/null 2>&1; then
  ok "终端守护进程正在运行"
else
  warn "终端守护进程没在运行"
  if [[ -f "${HOMEDIR}/.config/terminal-keepalive.paused" ]]; then
    tip "是被你手动关掉的(music terminal on 恢复)"
  else
    tip "跑 music terminal on 打开"
  fi
fi

# Ctrl+Alt+T 到底被绑成了什么
if command -v xfconf-query >/dev/null 2>&1; then
  _ks="$(xfconf-query -c xfce4-keyboard-shortcuts -l 2>/dev/null \
         | grep '/commands/custom/.*/command$' \
         | while read -r _p; do
             _v="$(xfconf-query -c xfce4-keyboard-shortcuts -p "$_p" 2>/dev/null || true)"
             case "$_v" in *Terminal*|*terminal*) printf '%s = %s\n' "${_p##*/}" "$_v" ;; esac
           done)"
  if grep -q 'terminal-new' <<<"$_ks"; then
    ok "Ctrl+Alt+T 已改成「同窗口新标签页」(不再盖住屏幕)"
  elif grep -qi 'terminal' <<<"$_ks"; then
    warn "Ctrl+Alt+T 仍然是「开新窗口」, 会盖住整个屏幕"
    tip "跑 music terminal setup 改成同窗口加标签页"
  else
    info "没找到终端相关的全局快捷键(可能 XFCE 版本不同)"
  fi
  [[ -n "$_ks" ]] && printf '%s\n' "$_ks" | sed 's/^/       /'
fi

if [[ -x /usr/local/bin/terminal-keys ]]; then
  tip "键位速查: music keys"
fi

# 桌面项的 Exec 兜底: 这个桌面既没有面板也没有桌面图标,
# 所以"开新终端"的入口只剩快捷键和命令 —— 桌面项必须已经指向 terminal-new。
_te="${HOMEDIR}/.local/share/applications/xfce4-terminal-emulator.desktop"
if [[ -f "$_te" ]]; then
  if grep -q '^Exec=/usr/local/bin/terminal-new' "$_te"; then
    ok "终端桌面项已指向 terminal-new(快捷键走 exo-open 也会开标签页)"
  else
    bad "终端桌面项的 Exec 没改 —— Ctrl+Alt+T 可能还是会盖住整个屏幕"
    tip "跑 music terminal setup 重新改"
  fi
else
  warn "没找到终端桌面项覆盖(快捷键可能还是会盖住屏幕)"
  tip "跑 music terminal setup 重新生成"
fi

############################## 3. 显示器分辨率 ##############################
sect "3. 显示器分辨率"
if ! command -v xrandr >/dev/null 2>&1; then
  bad "没有 xrandr 命令"
  tip "sudo apt-get install -y x11-xserver-utils"
elif [[ -z "${DISPLAY:-}" ]]; then
  warn "没有 DISPLAY, 读不到显示器信息(必须在图形界面里跑)"
else
  if xrandr --query >/dev/null 2>&1; then
    ok "xrandr 能读到显示服务"
    xrandr --query 2>/dev/null | grep -E ' connected| disconnected' | sed 's/^/       /'
    if [[ -f "${HOMEDIR}/.config/screen-fit/enabled" ]]; then
      ok "screen-fit 开机自动匹配: 已启用"
    else
      warn "screen-fit 开机自动匹配: 未启用(运行 screen-fit --enable 打开)"
      if (( FIX )); then
        mkdir -p "${HOMEDIR}/.config/screen-fit" && printf '1\n' > "${HOMEDIR}/.config/screen-fit/enabled"
        ok "已替你打开 screen-fit 开机自启(下次登录生效)"
      fi
    fi
    if [[ -x /usr/local/lib/screentools/fit.py ]]; then
      info "原生分辨率判定:"
      python3 /usr/local/lib/screentools/fit.py --list 2>&1 | sed 's/^/       /' || warn "fit.py 跑不起来"
    fi
  else
    bad "xrandr 连不上 X 显示服务"
    tip "DISPLAY=${DISPLAY:-<空>} 试试从图形界面的终端里执行"
  fi
fi

############################## 4. 磁盘与权限 ##############################
sect "4. 磁盘、分区与权限"
df -h / /mnt/songdisk 2>/dev/null | sed 's/^/     /' || warn "df 失败"

ROOT_SRC="$(findmnt -no SOURCE / 2>/dev/null || true)"
ROOT_SRC="$(readlink -f "$ROOT_SRC" 2>/dev/null || true)"
# 从 /dev/sdb3 顺着 sysfs 反推物理磁盘; 兜底才用 lsblk(只取单列 PKNAME)
ROOT_DISK="$(basename "$(readlink -f "/sys/class/block/$(basename "${ROOT_SRC:-x}")/.." 2>/dev/null)" 2>/dev/null || true)"
[[ -e "/sys/block/${ROOT_DISK:-x}" ]] || ROOT_DISK="$(lsblk -no PKNAME "$ROOT_SRC" 2>/dev/null | head -1 || true)"
if [[ -n "$ROOT_DISK" && -e "/sys/block/${ROOT_DISK}" ]]; then
  DISK="/dev/${ROOT_DISK}"
  TOTAL="$(cat "/sys/block/${ROOT_DISK}/size" 2>/dev/null || echo 0)"
  info "物理磁盘: ${DISK}  (总扇区 ${TOTAL})"

  # 分区名一律从 udev 数据库(/run/udev/data)拿, 不用 lsblk 的列名 ——
  # 不同发行版的 lsblk 认得的列不一样(PARTN/PARTLABEL/FSTYPE), 不认时它会打印
  # "unknown column: ..." 并返回非零, 这一节就会静默丢掉全部分区信息。
  # 块设备的 udev 条目文件名带 'b' 前缀(/run/udev/data/b8:3), 两种都试。
  part_prop() {   # part_prop <主:次> <ID_PART_ENTRY_NAME 之类的键>
    local f out
    for f in "/run/udev/data/b$1" "/run/udev/data/$1"; do
      [[ -r "$f" ]] || continue
      out="$(awk -v k="E: $2=" 'index($0,k)==1{print substr($0,length(k)+1); exit}' \
              "$f" 2>/dev/null)" || true
      [[ -n "$out" ]] && { printf '%s\n' "$out"; return 0; }
    done
    return 0
  }
  part_num_by_name() {   # part_num_by_name <GPT 分区名> -> 分区号
    local s mm nm
    for s in /sys/block/"${ROOT_DISK}"/"${ROOT_DISK}"*; do
      [[ -r "$s/partition" ]] || continue
      mm="$(cat "$s/dev" 2>/dev/null || true)"
      nm="$(part_prop "$mm" ID_PART_ENTRY_NAME)"
      [[ "$nm" == "$1" ]] && { cat "$s/partition" 2>/dev/null || true; return 0; }
    done
    return 0
  }
  for s in /sys/block/"${ROOT_DISK}"/"${ROOT_DISK}"*; do
    [[ -r "$s/partition" ]] || continue
    p="$(cat "$s/partition" 2>/dev/null || echo '?')"
    mm="$(cat "$s/dev" 2>/dev/null || true)"
    nm="$(part_prop "$mm" ID_PART_ENTRY_NAME)"
    printf '     p%-4s %-12s %s\n' "$p" "/dev/${s##*/}" "${nm:-无分区名}"
  done
  ROOT_P="$(part_num_by_name DEBIAN_ROOT)"
  MUSIC_P="$(part_num_by_name MUSIC)"
  if [[ -z "$ROOT_P" || -z "$MUSIC_P" ]]; then
    # 非 root 时 udev 数据库里也可能没有 GPT 分区名, 这时退回看挂载点
    ROOT_P="${ROOT_P:-$(findmnt -no SOURCE / 2>/dev/null | grep -oE '[0-9]+$' || true)}"
  fi
  MUSIC_LAST="$(sgdisk -i "${MUSIC_P:-1}" "$DISK" 2>/dev/null | awk '/Last sector:/{print $3}' || true)"
  if [[ -n "$MUSIC_LAST" && "$TOTAL" =~ ^[0-9]+$ ]]; then
    FREE=$(( TOTAL - MUSIC_LAST - 1 ))
    if (( FREE > 0 )); then
      warn "还有 $((FREE/2097152)) GiB 没分配(所以 U 盘剩余空间用不上)"
      tip "开机时 usb-grow.service 应该自动处理; 没生效就看: sudo systemctl status usb-grow"
      tip "手动补: sudo usb-grow.sh --check   先看诊断"
      GUESSED_HINTS="${GUESSED_HINTS}还有 $((FREE/2097152)) GiB 未分配, 开机自扩容没跑成功\n"
    else
      ok "磁盘空间已经全部分完"
    fi
  elif [[ -z "$MUSIC_LAST" ]]; then
    info "读不到 MUSIC 分区末尾扇区(需要 root 才能读整盘), 跳过剩余空间检查"
  fi

  # 开机自扩容跑没跑过: 有 journal 就能看出来, 没 journal 也不该因此报错
  if command -v systemctl >/dev/null 2>&1; then
    _grow_state="$(systemctl is-active usb-grow.service 2>/dev/null || true)"
    case "$_grow_state" in
      active)
        ok "开机自动扩容(usb-grow.service)已执行完成" ;;
      failed)
        bad "开机自动扩容失败了 —— 看日志: sudo journalctl -u usb-grow -n 50"
        tip "手动补一次: sudo usb-grow.sh"
        ;;
      *)
        info "开机自动扩容还没执行(正常: 首次开机前它一直是 inactive)"
        ;;
    esac
  fi
else
  warn "推断不出物理磁盘(findmnt/lsblk 失败)"
fi

for d in / /mnt/songdisk; do
  if mountpoint -q "$d" 2>/dev/null; then
    ok "${d} 已挂载"
  else
    bad "${d} 没有挂载"
    tip "sudo mount ${d}"
  fi
  if [[ -w "$d" ]]; then
    ok "${d} 可写(当前用户 $(id -un))"
  else
    bad "${d} 不可写 —— 这是你遇到的权限问题"
    tip "sudo chown $(id -un):$(id -gn) ${d}"
  fi
done
if command -v sudo >/dev/null 2>&1; then
  if sudo -n true 2>/dev/null; then
    ok "sudo 可用且免密(不会问密码)"
  else
    warn "sudo 需要输入密码"
  fi
fi

############################## 5. 网络与代理 ##############################
sect "5. 网络与代理"
info "网卡: $(ip -br -4 addr show scope global 2>/dev/null | awk '{print $1" "$4}' | tr '\n' ' ' || echo '读不到')"
info "默认路由: $(ip route show default 2>/dev/null | head -1 || echo '没有')"
if getent hosts www.baidu.com >/dev/null 2>&1; then
  ok "域名解析正常"
else
  bad "域名解析失败"
fi
if getent hosts pypi.tuna.tsinghua.edu.cn >/dev/null 2>&1; then
  ok "能解析清华源(apt 源已换)"
else
  warn "解析不了清华源, apt 可能很慢"
fi
if [[ -f /etc/apt/sources.list ]]; then
  info "apt 源: $(grep -m1 '^deb ' /etc/apt/sources.list 2>/dev/null | awk '{print $2}' || echo '?')"
fi
if [[ -x /usr/local/bin/proxy ]]; then
  echo "  代理:"
  /usr/local/bin/proxy status 2>&1 | sed 's/^/       /' || warn "proxy status 跑失败"
fi

# 音乐工具(search/下载)一律走直连 —— 实测环境里的 http_proxy 反而会让站点回 403
# 反爬页, 症状是"浏览器能看、music search 搜到 0 条"。这里按直连探一次,
# 直接回答"搜歌现在通不通"。
if command -v curl >/dev/null 2>&1; then
  SITE_CODE="$(curl -s -o /dev/null -m 15 --noproxy '*' -w '%{http_code}' \
    'https://www.gequhai.com/search?s=probe' 2>/dev/null || echo 000)"
  SITE_CODE="${SITE_CODE:-000}"
  case "$SITE_CODE" in
    200) ok "音乐站点直连可达(200) —— music search 能用" ;;
    000) bad "音乐站点直连不通 —— 检查网线/DNS/防火墙" ;;
    403) warn "音乐站点直连被挡(403) —— 多半被限流, 过几分钟再搜" ;;
    *)   warn "音乐站点直连返回 ${SITE_CODE} —— music search 可能受影响" ;;
  esac
  if env | grep -qiE '^(http|https|all)_proxy='; then
    info "当前 shell 设了代理, 但 music 工具会自动绕开它(直连才通, 见 README)"
  fi
fi

############################## 6. 夸克 Cookie ##############################
sect "6. 夸克 Cookie(决定能不能下歌)"
CFG="/home/user/projects/gequhai-downloader/config.json"
if [[ -f "$CFG" ]]; then
  info "配置文件: ${CFG}"
  COOKIE="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1],encoding="utf-8")).get("quark_cookie",""))' "$CFG" 2>/dev/null || echo '')"
  if [[ -z "$COOKIE" ]]; then
    bad "config.json 里没有 quark_cookie —— 转存一定失败"
    tip "music quark-login   (终端扫码, 不需要浏览器)"
  else
    ok "已配置 quark_cookie (${#COOKIE} 字符)"
    NAMES="$(printf '%s' "$COOKIE" | tr ';' '\n' | sed 's/=.*//' | tr -d ' ' | grep -v '^$' | tr '\n' ' ')"
    info "包含字段: ${NAMES}"
    if printf '%s' "$COOKIE" | grep -q '__pus'; then
      ok "含主凭证 __pus ✅"
    else
      bad "缺少主凭证 __pus —— 这会让夸克把请求当游客, 下载必然失败"
      tip "多半是用 F12 的 document.cookie 取的, 那个拿不到 HttpOnly 的 __pus"
      tip "正确做法: music quark-login"
    fi
  fi
else
  bad "找不到 ${CFG}(项目可能没预装, WITH_PROJECTS=0?)"
fi

############################## 7. 播放器 ##############################
sect "7. 播放器 (music play)"
if command -v music-shell >/dev/null 2>&1; then
  ok "music-shell 已安装: $(music-shell --version 2>/dev/null || echo '版本读不到')"
  MS_CFG="/home/user/.config/music-shell/config.json"
  if [[ -f "$MS_CFG" ]]; then
    LIB="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1],encoding="utf-8")).get("library_path",""))' "$MS_CFG" 2>/dev/null || echo '?')"
    info "乐库配置: ${LIB}"
    if mountpoint -q "${LIB:-/mnt/songdisk}" 2>/dev/null; then
      N="$(find "${LIB:-/mnt/songdisk}" -type f \( -iname '*.mp3' -o -iname '*.flac' -o -iname '*.wav' -o -iname '*.m4a' -o -iname '*.ogg' -o -iname '*.opus' \) 2>/dev/null | wc -l)"
      ok "乐库已挂载, 有 ${N} 个音频文件"
      if [[ "$N" -eq 0 ]]; then
        tip "music single \"歌名\"   (先下几首歌再开播放器)"
      fi
    else
      warn "乐库目录不是挂载点(${LIB}) —— music play 会先尝试自动挂载"
      tip "songdisk_check 会自己挂; 挂不上就检查 U 盘写入模式(需 DD)"
    fi
  else
    warn "找不到 ${MS_CFG} —— 播放器会用默认乐库 ~/Music(通常是空的)"
  fi
  if id -nG user 2>/dev/null | grep -qw audio; then
    ok "user 在 audio 组(能直接访问声卡)"
  else
    bad "user 不在 audio 组 —— 播放会报 Permission denied"
    tip "sudo usermod -aG audio user 后重新登录"
  fi
  if command -v aplay >/dev/null 2>&1; then
    if aplay -l 2>/dev/null | grep -q '^card'; then
      ok "声卡存在: $(aplay -l 2>/dev/null | grep '^card' | head -1)"
    else
      warn "aplay 看不到声卡 —— 播放可能没声音(检查 BIOS/驱动)"
    fi
  fi
else
  bad "music-shell 没装 —— music play 不可用"
  tip "镜像里应预装; 或从 github.com/yao1987825/music-shell/releases 下载"
fi

############################## 汇总 ##############################
sect "汇总"
if (( BAD == 0 )); then
  printf '%s✅ 没查出问题%s\n' "$GRN" "$RST"
else
  printf '%s❌ 查出 %d 处问题%s(上面每条都有对应的 → 修复命令)\n' "$RED" "$BAD" "$RST"
fi
if [[ -n "$GUESSED_HINTS" ]]; then
  echo
  echo "关键线索:"
  printf '%s\n' "$GUESSED_HINTS" | sed "s/^/  - /"
fi
echo
printf '%s把上面整段(含这一行)发回给我, 我按线索逐条修:%s\n' "$DIM" "$RST"
printf '%s一键生成: music-health 2>&1 | tee ~/health.txt%s\n' "$DIM" "$RST"
exit 0